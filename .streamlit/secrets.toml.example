# Copy to .streamlit/secrets.toml (never commit it) or paste into
# Streamlit Community Cloud -> App settings -> Secrets.
# Leave DATABASE_URL unset to use the local SQLite file.

DATABASE_URL = "postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Optional overrides
# NOVA_TIMEZONE = "Asia/Kolkata"
# NOVA_FEVER_THRESHOLD_C = "38.0"
# NOVA_SEED_DEMO = "1"
